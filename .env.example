# Copia este fichero como .env y rellena los valores. .env NO se sube a git.
# En Vercel, las mismas variables van en Settings > Environment Variables (marcadas como Sensitive).

# Supabase: Project Settings > API Keys
SUPABASE_URL=
# Clave publicable (empieza por sb_publishable_)
SUPABASE_KEY=
# Clave secreta (empieza por sb_secret_). Se salta RLS: solo en el servidor, nunca en el navegador ni en git.
SUPABASE_SECRET=

# Stripe en modo prueba: https://dashboard.stripe.com/test/apikeys (empieza por sk_test_)
STRIPE_SECRET_KEY=

# Secreto del webhook (empieza por whsec_). Stripe > Desarrolladores > Webhooks > tu endpoint.
STRIPE_WEBHOOK_SECRET=

# Correos de pedido con Resend (Vercel > Integrations > Resend la crea sola; empieza por re_)
RESEND_API_KEY=
# Quién recibe los pedidos en la bodega (varios, separados por comas)
CORREO_PEDIDOS=
# Opcional, cuando el dominio esté verificado en Resend: Bodegas Galán Portero <pedidos@dominio.es>
CORREO_REMITENTE=
