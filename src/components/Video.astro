---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Fachada de YouTube: se pinta el póster y no se toca youtube.com hasta que el
 * usuario pulsa. Un iframe normal mete ~1 MB de JS de terceros en la carga
 * inicial y se lleva por delante la puntuación de rendimiento.
 *
 * `youtube-nocookie.com` para no plantar cookies de seguimiento a quien nunca
 * llega a darle al play.
 */

interface Props {
  id: string;
  titulo: string;
  poster: ImageMetadata;
  duracion?: string;
}

const { id, titulo, poster, duracion } = Astro.props;
---

<div class="video" data-video={id}>
  <button class="video__lanzar" type="button" data-lanzar>
    <Image
      class="video__poster"
      src={poster}
      alt=""
      widths={[640, 960, 1280]}
      sizes="(max-width: 62rem) 92vw, 56rem"
      loading="lazy"
    />
    <span class="video__velo"></span>
    <span class="video__play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="26" height="26"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
    </span>
    <span class="video__pie">
      <span class="video__titulo">{titulo}</span>
      {duracion && <span class="video__duracion sello sello--tenue">{duracion}</span>}
    </span>
    <span class="oculto-visual">Reproducir el vídeo: {titulo}</span>
  </button>
</div>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--azabache-80);
    border: 1px solid var(--filete);
    overflow: hidden;
  }

  .video__lanzar {
    all: unset;
    display: block;
    position: absolute;
    inset: 0;
    cursor: pointer;
  }

  .video__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      scale 0.7s var(--salida),
      filter 0.5s var(--salida);
  }

  .video__velo {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      0deg,
      color-mix(in srgb, var(--azabache) 88%, transparent) 0%,
      transparent 55%
    );
  }

  .video__play {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    display: grid;
    place-content: center;
    width: 4.5rem;
    height: 4.5rem;
    padding-left: 0.2rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--oro) 92%, transparent);
    color: var(--azabache);
    transition:
      scale 0.35s var(--rebote),
      background-color 0.35s var(--salida);
  }

  .video__lanzar:hover .video__play,
  .video__lanzar:focus-visible .video__play {
    scale: 1.12;
    background: var(--oro-claro);
  }

  .video__lanzar:hover .video__poster,
  .video__lanzar:focus-visible .video__poster {
    scale: 1.03;
    filter: brightness(1.06);
  }

  .video__pie {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--e-3);
    display: grid;
    gap: 0.45rem;
  }

  .video__titulo {
    font-family: var(--display);
    font-size: var(--t-1);
    line-height: 1.15;
    color: var(--albariza);
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.8);
  }

  .video__duracion {
    color: color-mix(in srgb, var(--albariza) 70%, transparent);
  }

  .video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .video__poster,
    .video__play {
      transition: none;
    }
    .video__lanzar:hover .video__poster {
      scale: 1;
    }
  }
</style>

<script>
  function montarVideos() {
    for (const caja of document.querySelectorAll<HTMLElement>('[data-video]')) {
      const boton = caja.querySelector<HTMLButtonElement>('[data-lanzar]');
      if (!boton) continue;

      boton.addEventListener(
        'click',
        () => {
          const marco = document.createElement('iframe');
          marco.src = `https://www.youtube-nocookie.com/embed/${caja.dataset.video}?autoplay=1&rel=0`;
          marco.title = boton.textContent?.trim() ?? 'Vídeo';
          marco.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture; fullscreen';
          marco.allowFullscreen = true;
          caja.replaceChildren(marco);
        },
        { once: true },
      );
    }
  }

  montarVideos();
  document.addEventListener('astro:page-load', montarVideos);
</script>
