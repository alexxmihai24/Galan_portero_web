---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
/**
 * Fachada de YouTube: solo se carga el reproductor (y sus cookies) cuando
 * alguien pulsa. Hasta entonces es una imagen y un botón.
 */
interface Props {
  id: string;
  titulo: string;
  poster: ImageMetadata;
}
const { id, titulo, poster } = Astro.props;
---

<div class="video" data-video={id}>
  <button class="video__lanzar" type="button" data-lanzar>
    <Image class="video__poster" src={poster} alt="" widths={[640, 960, 1280]} sizes="(max-width: 900px) 92vw, 640px" loading="lazy" />
    <span class="video__play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
    </span>
    <span class="video__pie">{titulo}</span>
    <span class="oculto-visual">Reproducir el vídeo: {titulo}</span>
  </button>
</div>

<script>
  function montarVideos() {
    for (const caja of document.querySelectorAll<HTMLElement>('[data-video]')) {
      const boton = caja.querySelector<HTMLButtonElement>('[data-lanzar]');
      if (!boton) continue;
      boton.addEventListener(
        'click',
        () => {
          const marco = document.createElement('iframe');
          marco.src = `https://www.youtube-nocookie.com/embed/${caja.dataset.video}?autoplay=1&rel=0`;
          marco.title = boton.querySelector('.video__pie')?.textContent?.trim() ?? 'Vídeo';
          marco.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture; fullscreen';
          marco.allowFullscreen = true;
          caja.replaceChildren(marco);
        },
        { once: true },
      );
    }
  }
  document.addEventListener('astro:page-load', montarVideos);
</script>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radio-g);
    background: var(--hierro);
    box-shadow: 0 20px 50px rgba(23, 20, 18, 0.25);
  }

  .video :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video__lanzar {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--cal);
    text-align: left;
  }

  .video__lanzar :global(.video__poster) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--curva);
  }

  .video__lanzar:hover :global(.video__poster) {
    transform: scale(1.04);
  }

  .video__lanzar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(23, 20, 18, 0) 45%, rgba(23, 20, 18, 0.85));
  }

  .video__play {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    translate: -50% -50%;
    border: 4px solid var(--cal);
    border-radius: 50%;
    background: var(--albero);
    color: var(--hierro);
    transition: scale 0.3s var(--curva);
  }

  .video__lanzar:hover .video__play {
    scale: 1.1;
  }

  .video__pie {
    position: absolute;
    z-index: 1;
    left: 24px;
    right: 24px;
    bottom: 20px;
    font-weight: 700;
    line-height: 1.3;
  }
</style>
