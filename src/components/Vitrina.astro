---
import { Image } from 'astro:assets';
import { cincoEssences, euros, type Vino } from '../data/vinos';

/**
 * La vitrina. Al pasar el ratón, un único marco dorado flotante se desplaza
 * hasta la celda apuntada (la técnica de infolavelada.com); al pinchar, el panel
 * de la izquierda hace crossfade a la ficha de cata de ese vino.
 *
 * El atenuado de las celdas no activas lo resuelve `:has()` en CSS, así que el
 * JS sólo tiene que mover el marco y cambiar el panel.
 */

interface Props {
  vinos?: Vino[];
}

const { vinos = cincoEssences } = Astro.props;
---

<section class="vitrina grano" data-vitrina>
  <div class="vitrina__interior contenedor">
    <!-- Escena: todos los paneles apilados en la misma celda de rejilla, así
         la altura la marca el más alto y no hay saltos al cambiar. -->
    <div class="escena">
      <div class="panel panel--activo" data-panel="defecto">
        <p class="sello">La gama</p>
        <h2 class="panel__titulo display">5 Essences</h2>
        <p class="panel__texto">
          Desde mediados del siglo pasado hemos ido evolucionando y tomando experiencia para lograr
          desarrollar una gama propia de los vinos generosos de la Denominación de Origen Protegida
          Montilla-Moriles, siempre manteniendo nuestros máximos estándares de calidad.
        </p>
        <p class="panel__pista italica">
          Pasa el ratón sobre una botella. Pincha para conocerla.
        </p>
      </div>

      {
        vinos.map((v) => (
          <div class="panel" data-panel={v.slug}>
            <p class="sello">{v.estilo}</p>
            <h2 class="panel__titulo display">{v.corto}</h2>
            <p class="panel__gancho italica">{v.gancho}</p>

            <dl class="cata">
              <div>
                <dt class="sello sello--tenue">Color</dt>
                <dd>{v.cata.color}</dd>
              </div>
              <div>
                <dt class="sello sello--tenue">Nariz</dt>
                <dd>{v.cata.aroma}</dd>
              </div>
              <div>
                <dt class="sello sello--tenue">Boca</dt>
                <dd>{v.cata.boca}</dd>
              </div>
            </dl>

            <p class="panel__precio">
              Desde <strong>{euros(Math.min(...v.variaciones.map((x) => x.precio)))}</strong>
            </p>

            <a class="boton" href={`/vinos/${v.slug}`}>
              Ver la ficha
              <span class="boton__flecha" aria-hidden="true">
                &rarr;
              </span>
            </a>
          </div>
        ))
      }
    </div>

    <div class="rejilla" data-rejilla>
      {
        vinos.map((v) => (
          <button class="celda" type="button" data-celda={v.slug} aria-pressed="false">
            <Image
              class="celda__img"
              src={v.imagen}
              alt={v.nombre}
              widths={[240, 420, 640]}
              sizes="(max-width: 48rem) 30vw, 14rem"
              loading="lazy"
            />
            <span class="celda__pie">{v.corto}</span>
          </button>
        ))
      }
      <span class="marco" data-marco aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  .vitrina {
    position: relative;
    background: linear-gradient(180deg, var(--azabache) 0%, var(--azabache-80) 55%, var(--azabache) 100%);
    padding-block: var(--e-6);
    overflow: hidden;
  }

  .vitrina__interior {
    display: grid;
    gap: var(--e-4);
    align-items: center;
  }

  @media (width >= 62rem) {
    .vitrina__interior {
      grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
      gap: var(--e-5);
    }
  }

  /* ----------------------------------------------------------- paneles */

  .escena {
    display: grid;
    isolation: isolate;
  }

  .panel {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.6rem);
    transition:
      opacity 0.35s var(--salida),
      transform 0.45s var(--salida),
      visibility 0s linear 0.35s;
  }

  .panel--activo {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .panel__titulo {
    font-size: var(--t-4);
    margin-block: 0.35em 0.3em;
    /* degradado crema → oro sobre el nombre, como el metal de la etiqueta */
    background: linear-gradient(
      180deg,
      var(--albariza) 0%,
      var(--albariza) 44%,
      color-mix(in srgb, var(--oro-claro) 92%, var(--albariza)) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .panel__gancho {
    font-size: var(--t-1);
    color: color-mix(in srgb, var(--albariza) 88%, transparent);
    margin-bottom: var(--e-3);
  }

  .panel__texto {
    color: var(--texto-tenue);
    margin-bottom: var(--e-2);
  }

  .panel__pista {
    color: color-mix(in srgb, var(--oro) 80%, transparent);
    font-size: var(--t--1);
  }

  .cata {
    display: grid;
    gap: var(--e-2);
    margin: 0 0 var(--e-3);
    border-top: 1px solid var(--filete);
    padding-top: var(--e-2);
  }

  .cata dt {
    margin-bottom: 0.35em;
  }

  .cata dd {
    margin: 0;
    font-size: var(--t--1);
    line-height: 1.6;
    color: color-mix(in srgb, var(--albariza) 76%, transparent);
  }

  .panel__precio {
    font-size: var(--t--1);
    color: var(--texto-tenue);
    margin-bottom: var(--e-2);
  }

  .panel__precio strong {
    font-family: var(--display);
    font-size: var(--t-1);
    font-weight: 400;
    color: var(--albariza);
  }

  /* ----------------------------------------------------------- rejilla */

  .rejilla {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr));
    gap: 0;
  }

  .celda {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 0.75rem;
    justify-items: center;
    padding: clamp(1rem, 2.5vw, 2rem) 0.5rem clamp(0.9rem, 2vw, 1.5rem);
    background: color-mix(in srgb, var(--azabache) 92%, var(--caoba));
    border: 0;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--oro) 22%, transparent);
    cursor: pointer;
    transition:
      box-shadow 0.5s var(--salida),
      transform 0.5s var(--salida);
  }

  /* Los dos halos: dorado para la celda apuntada. Viven en ::before para poder
     desvanecerse sin repintar el fondo. */
  .celda::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    transition: opacity 0.5s var(--salida);
    background: radial-gradient(
      ellipse 90% 90% at 50% 35%,
      color-mix(in srgb, var(--oro) 95%, white) 0%,
      var(--oro) 45%,
      color-mix(in srgb, var(--oro) 45%, var(--azabache)) 100%
    );
  }

  .celda:hover::before,
  .celda:focus-visible::before,
  .celda[aria-pressed='true']::before {
    opacity: 1;
  }

  .celda:hover,
  .celda:focus-visible,
  .celda[aria-pressed='true'] {
    z-index: 3;
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--oro) 70%, transparent),
      0 0 18px 0 color-mix(in srgb, var(--oro) 55%, transparent);
  }

  .celda__img {
    width: 100%;
    height: auto;
    object-fit: contain;
    transition:
      opacity 0.5s var(--salida),
      filter 0.5s var(--salida),
      transform 0.5s var(--salida);
  }

  .celda:hover .celda__img,
  .celda:focus-visible .celda__img {
    transform: scale(1.05);
    filter: saturate(1.08) brightness(1.05);
  }

  /* Atenúa las demás cuando una está apuntada — sin una línea de JS. */
  .rejilla:has(.celda:hover) .celda:not(:hover) .celda__img,
  .rejilla:has(.celda:focus-visible) .celda:not(:focus-visible) .celda__img {
    opacity: 0.5;
  }

  /* Y también cuando ya hay una elegida y el ratón está fuera. */
  .rejilla:has(.celda[aria-pressed='true']):not(:has(.celda:hover))
    .celda:not([aria-pressed='true'])
    .celda__img {
    opacity: 0.55;
  }

  .celda__pie {
    font-family: var(--sello);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: color-mix(in srgb, var(--albariza) 70%, transparent);
    transition: color 0.4s var(--salida);
    text-align: center;
  }

  .celda:hover .celda__pie,
  .celda:focus-visible .celda__pie,
  .celda[aria-pressed='true'] .celda__pie {
    color: var(--azabache);
  }

  /* ------------------------------------------------------------- marco */
  /* Un solo elemento que viaja hasta la celda apuntada. */

  .marco {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    opacity: 0;
    z-index: 4;
    pointer-events: none;
    will-change: transform;
    transition:
      transform 0.26s var(--salida),
      width 0.26s var(--salida),
      height 0.26s var(--salida),
      opacity 0.2s linear;
  }

  .marco::before {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--oro) 65%, transparent),
      0 0 22px 0 color-mix(in srgb, var(--oro) 45%, transparent);
  }

  /* Las cuatro escuadras de la mira */
  .marco::after {
    content: '';
    position: absolute;
    inset: -5px;
    background:
      linear-gradient(var(--oro-claro), var(--oro-claro)) 0 0 / 12px 1px no-repeat,
      linear-gradient(var(--oro-claro), var(--oro-claro)) 0 0 / 1px 12px no-repeat,
      linear-gradient(var(--oro-claro), var(--oro-claro)) 100% 0 / 12px 1px no-repeat,
      linear-gradient(var(--oro-claro), var(--oro-claro)) 100% 0 / 1px 12px no-repeat,
      linear-gradient(var(--oro-claro), var(--oro-claro)) 0 100% / 12px 1px no-repeat,
      linear-gradient(var(--oro-claro), var(--oro-claro)) 0 100% / 1px 12px no-repeat,
      linear-gradient(var(--oro-claro), var(--oro-claro)) 100% 100% / 12px 1px no-repeat,
      linear-gradient(var(--oro-claro), var(--oro-claro)) 100% 100% / 1px 12px no-repeat;
  }

  .marco.visible {
    opacity: 1;
    animation: 0.24s var(--rebote) marco-pop;
  }

  @keyframes marco-pop {
    from {
      opacity: 0;
      scale: 0.92;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marco {
      transition: opacity 0.2s linear;
    }
    .marco.visible {
      animation: none;
    }
    .celda,
    .celda__img,
    .panel {
      transition-duration: 0.01ms;
    }
    .celda:hover .celda__img,
    .celda:focus-visible .celda__img {
      transform: none;
    }
  }
</style>

<script>
  function montarVitrina() {
    for (const vitrina of document.querySelectorAll<HTMLElement>('[data-vitrina]')) {
      const rejilla = vitrina.querySelector<HTMLElement>('[data-rejilla]');
      const marco = vitrina.querySelector<HTMLElement>('[data-marco]');
      if (!rejilla || !marco) continue;

      const celdas = [...rejilla.querySelectorAll<HTMLButtonElement>('[data-celda]')];
      const paneles = [...vitrina.querySelectorAll<HTMLElement>('[data-panel]')];
      let elegida: HTMLButtonElement | null = null;

      const colocar = (celda: HTMLElement) => {
        marco.style.transform = `translate(${celda.offsetLeft}px, ${celda.offsetTop}px)`;
        marco.style.width = `${celda.offsetWidth}px`;
        marco.style.height = `${celda.offsetHeight}px`;
        marco.classList.add('visible');
      };

      const soltar = () => {
        if (elegida) colocar(elegida);
        else marco.classList.remove('visible');
      };

      const mostrarPanel = (clave: string) => {
        for (const p of paneles) {
          p.classList.toggle('panel--activo', p.dataset.panel === clave);
        }
      };

      for (const celda of celdas) {
        celda.addEventListener('pointerenter', () => colocar(celda));
        celda.addEventListener('focus', () => colocar(celda));

        celda.addEventListener('click', () => {
          const slug = celda.dataset.celda!;
          const yaEstaba = elegida === celda;

          for (const c of celdas) c.setAttribute('aria-pressed', 'false');

          if (yaEstaba) {
            elegida = null;
            mostrarPanel('defecto');
          } else {
            celda.setAttribute('aria-pressed', 'true');
            elegida = celda;
            mostrarPanel(slug);
          }
        });
      }

      rejilla.addEventListener('pointerleave', soltar);
      rejilla.addEventListener('focusout', (e) => {
        if (!rejilla.contains(e.relatedTarget as Node)) soltar();
      });

      // La geometría cambia con el ancho; recolocar sin recalcular en cada frame.
      const ro = new ResizeObserver(() => {
        if (marco.classList.contains('visible')) soltar();
      });
      ro.observe(rejilla);
    }
  }

  montarVitrina();
  document.addEventListener('astro:page-load', montarVitrina);
</script>
