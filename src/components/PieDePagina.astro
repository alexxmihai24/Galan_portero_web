---
import { Image } from 'astro:assets';
import { TIENDA, ENVIO_GRATIS_DESDE } from '../data/vinos';
import escudo from '../assets/marca/escudo-cal.png';

const navegacion = [
  { href: '/vinos', texto: 'Vinos' },
  { href: '/bodega', texto: 'La bodega' },
  { href: '/produccion', texto: 'El proceso' },
  { href: '/personalizados', texto: 'Personalizados' },
  { href: '/contacto', texto: 'Contacto' },
  { href: '/cuenta', texto: 'Mi cuenta' },
];
---

<footer class="pie oscuro diferido">
  <div class="contenedor">
    <div class="pie__columnas">
      <div class="pie__marca">
        <Image src={escudo} alt="" height={128} class="pie__escudo" />
        <p class="pie__lema">Envíos gratis a península desde {ENVIO_GRATIS_DESDE}&nbsp;€.</p>
      </div>
      <div>
        <h2 class="antetitulo">Bodega principal</h2>
        <address class="pie__texto">Av. del Marqués de la Vega de Armijo, 76<br />14550 Montilla, Córdoba</address>
      </div>
      <div>
        <h2 class="antetitulo">Lagar El Puntal</h2>
        <address class="pie__texto">Carretera A-3130, km 24<br />14550 Montilla, Córdoba</address>
      </div>
      <div>
        <h2 class="antetitulo">Contacto</h2>
        <ul class="pie__lista pie__texto" role="list">
          <li><a href="tel:+34957664237">957 66 42 37</a></li>
          <li><a href="mailto:info@bodegasgalanportero.com">info@bodegasgalanportero.com</a></li>
          <li><a href="https://www.instagram.com/bodegasgalanportero/" rel="noopener">Instagram</a></li>
          <li><a href="https://www.facebook.com/bodegasgalanportero/" rel="noopener">Facebook</a></li>
        </ul>
      </div>
      <nav aria-label="Pie de página">
        <h2 class="antetitulo">La web</h2>
        <ul class="pie__lista pie__texto" role="list">
          {navegacion.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}
        </ul>
      </nav>
    </div>

    <p class="pie__gigante" aria-hidden="true">Galán <span class="cursiva">Portero</span></p>

    <div class="pie__legal">
      <p>© {new Date().getFullYear()} Bodegas Galán Portero · Montilla · Venta de alcohol solo a mayores de 18 años.</p>
      <ul class="pie__lista-linea" role="list">
        <li><a href={`${TIENDA}/politica-de-privacidad`} rel="noopener">Privacidad</a></li>
        <li><a href={`${TIENDA}/terminos-y-condiciones`} rel="noopener">Términos</a></li>
        <li><a href={`${TIENDA}/declaracion-de-accesibilidad`} rel="noopener">Accesibilidad</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .pie {
    background: var(--hierro);
    padding-block: clamp(56px, 6vw, 80px) 28px;
    overflow: hidden;
  }

  .pie__columnas {
    display: grid;
    grid-template-columns: 1.4fr repeat(4, minmax(0, 1fr));
    gap: 40px;
  }

  .pie__marca {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .pie__marca :global(.pie__escudo) {
    width: auto;
    height: 64px;
    flex-shrink: 0;
  }

  .pie__lema {
    font-family: var(--fraunces);
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1.3;
    max-width: 16ch;
  }

  .pie__texto {
    margin-top: 14px;
    font-size: 0.9375rem;
    font-style: normal;
    line-height: 1.6;
    color: var(--caoba-texto);
  }

  .pie__lista {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 4px;
  }

  .pie a {
    text-decoration: none;
    text-underline-offset: 5px;
  }

  .pie a:hover {
    text-decoration: underline;
    text-decoration-color: var(--albero);
    color: var(--cal);
  }

  .pie__lista a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }

  .pie__gigante {
    margin-top: clamp(40px, 5vw, 64px);
    font-size: min(13.4vw, 12.25rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.8;
    white-space: nowrap;
  }

  .pie__gigante .cursiva {
    font-weight: 300;
    letter-spacing: -0.03em;
  }

  .pie__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    margin-top: 32px;
    font-size: 0.875rem;
    color: var(--gris-tostado);
  }

  .pie__lista-linea a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }

  .pie__lista-linea {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    list-style: none;
    padding: 0;
  }

  @media (max-width: 1099px) {
    .pie__columnas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pie__marca {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .pie__columnas {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
