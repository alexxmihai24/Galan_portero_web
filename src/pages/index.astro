---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import TarjetaVino from '../components/TarjetaVino.astro';
import { catalogo, principal } from '../lib/catalogo';
import { euros } from '../data/vinos';

import pasera from '../assets/fotos/pasera-montilla.jpg';
import barrica from '../assets/fotos/barrica.jpg';
import vides from '../assets/fotos/vides.jpg';
import terreno from '../assets/fotos/terreno.jpg';
import lagar from '../assets/fotos/lagar-montilla.jpg';
import solera from '../assets/fotos/solera.jpg';
import copas from '../assets/fotos/copas.jpg';
import solera2 from '../assets/fotos/solera-2.jpg';
import patio from '../assets/fotos/patio.jpg';
import escudo from '../assets/marca/escudo-tinta.png';

export const prerender = false; // precios y stock salen de la base de datos

const { vinos, pack } = await catalogo();
const esencias = vinos.filter((v) => v.gama === '5 Essences');
const marques = vinos.filter((v) => v.gama === 'Marqués de la Vega');
const packALaVenta = pack.activo && pack.stock !== 0;

const pasos = [
  { foto: vides, titulo: 'La viña', texto: 'Pedro Ximénez de la campiña de Montilla, sobre tierra albariza.', alt: 'Viñedo de Pedro Ximénez en la campiña', pegatina: '01' },
  { foto: terreno, titulo: 'La pasera', texto: 'La uva se solea entre 8 y 16 días, hasta casi ser pasa.', alt: 'Pasera con la uva extendida al sol y Montilla al fondo', pegatina: '02 · 8 a 16 días al sol' },
  { foto: lagar, titulo: 'El lagar', texto: 'Una vez alcanzado su nivel óptimo, la pasa se moltura.', alt: 'Fachada encalada del lagar en Montilla', pegatina: '03' },
  { foto: solera, titulo: 'La solera', texto: 'Criaderas y soleras en botas de roble americano.', alt: 'Botas de roble apiladas en la solera', pegatina: '04' },
];
---

<Base
  titulo="inicio"
  descripcion="Pedro Ximénez de Montilla-Moriles hecho al sol desde 1950. Solera de más de 30 años, la gama 5 Essences y envío gratis a península desde 100 €."
>
  <!-- ============================================================ HERO -->
  <section class="hero contenedor" aria-labelledby="hero-titulo">
    <div class="hero__texto">
      <p class="antetitulo">Montilla · Córdoba · D.O.P. Montilla-Moriles</p>
      <h1 id="hero-titulo" class="titular titular--hero hero__titulo">
        <span class="hero__linea">Se hace</span>
        <span class="hero__linea hero__linea--sol">
          <span class="hero__sol" aria-hidden="true"></span>
          <span class="cursiva">al sol.</span>
        </span>
      </h1>
      <p class="lectura hero__entrada">
        Vinos puros de pasas, naturales, dulces, de color rubí oscuro, obtenidos a partir del soleado previo de
        la uva, casi hasta la pasificación.
      </p>
      <div class="hero__acciones">
        <a class="boton boton--primario" href="/vinos">Comprar vinos <Icono nombre="flecha" /></a>
        <a class="boton" href="/bodega">Conoce la bodega</a>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__arco">
        <Picture
          src={pasera}
          formats={['avif', 'webp']}
          alt="Uva Pedro Ximénez soleándose en la pasera, con Montilla al fondo"
          width={560}
          height={744}
          fit="cover"
          quality={40}
          widths={[380, 560, 760, 1120]}
          sizes="(max-width: 900px) 92vw, 560px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <span class="pegatina pegatina--mono hero__px">px</span>
      <span class="pegatina pegatina--persiana hero__cien">100% Pedro Ximénez</span>
      <div class="sello hero__sello" aria-hidden="true">
        <svg class="sello__aro" viewBox="0 0 156 156">
          <defs><path id="aro-hero" d="M78,78 m-58,0 a58,58 0 1,1 116,0 a58,58 0 1,1 -116,0"></path></defs>
          <text><textPath href="#aro-hero">DESDE 1950 · MONTILLA · SE HACE AL SOL · </textPath></text>
        </svg>
        <Image src={escudo} alt="" height={96} />
      </div>
    </div>
  </section>

  <!-- ============================================================ ZÓCALO -->
  <div class="zocalo cinta hero-cinta" aria-hidden="true" data-scroll-x>
    {
      [0, 1].map(() => (
        <div class="cinta__pista" aria-hidden="true">
          <span class="cinta__grande">Montilla-Moriles</span>
          <Icono nombre="sol" tam={52} />
          <span class="cinta__cursiva">desde 1950</span>
          <Icono nombre="sol" tam={52} />
          <span class="cinta__grande">Pedro Ximénez</span>
          <Icono nombre="sol" tam={52} />
          <span class="cinta__cursiva">se hace al sol</span>
          <Icono nombre="sol" tam={52} />
        </div>
      ))
    }
  </div>

  <!-- ============================================================ MANIFIESTO + CIFRAS -->
  <section class="seccion contenedor manifiesto" aria-labelledby="manifiesto-titulo">
    <p class="antetitulo revela">Nuestra casa · desde 1950</p>
    <h2 id="manifiesto-titulo" class="manifiesto__frase revela">
      Fruto de una historia marcada por la constancia en el trabajo, de una variedad de uva y un terreno
      <span class="cursiva">hechos el uno para el otro.</span>
    </h2>
    <ul class="cifras" role="list">
      <li class="cifra cifra--albero revela">
        <span class="cifra__pie">Fundación en Montilla</span>
        <span class="cifra__num">1950</span>
      </li>
      <li class="cifra cifra--caoba revela">
        <span class="cifra__pie cifra__pie--cursiva">años de solera madre</span>
        <span class="cifra__num" data-cuenta="30" data-prefijo="+">+30</span>
      </li>
      <li class="cifra cifra--foto revela">
        <Image src={barrica} alt="Botas de roble numeradas en la bodega" widths={[360, 540, 720]} sizes="(max-width: 700px) 92vw, 25vw" />
        <span class="pegatina cifra__pegatina">Criaderas y soleras</span>
      </li>
      <li class="cifra cifra--persiana revela">
        <span class="cifra__pie">g/l de azúcar natural</span>
        <span class="cifra__num" data-cuenta="415">415</span>
      </li>
    </ul>
  </section>

  <!-- ============================================================ PROCESO -->
  <section class="proceso fondo-cal-2" aria-labelledby="proceso-titulo">
    <div class="proceso__fijo">
      <div class="contenedor proceso__cabeza">
        <h2 id="proceso-titulo" class="titular titular--2">Del sol <span class="cursiva">a la solera</span></h2>
        <div class="proceso__flechas">
          <button class="boton-icono boton-icono--borde proceso__flecha" type="button" data-anterior aria-label="Paso anterior" aria-controls="proceso-pista">
            <Icono nombre="flecha-izq" />
          </button>
          <button class="boton-icono proceso__flecha proceso__flecha--llena" type="button" data-siguiente aria-label="Paso siguiente" aria-controls="proceso-pista">
            <Icono nombre="flecha" />
          </button>
        </div>
        <div class="proceso__progreso" aria-hidden="true"><span></span></div>
      </div>
      <div class="proceso__marco" data-carrusel data-scroll-x>
        <ol class="proceso__pista" id="proceso-pista" data-pista role="list" tabindex="0" aria-label="Los cuatro pasos del Pedro Ximénez">
          {
            pasos.map((p, i) => (
              <li class="paso">
                <div class="paso__visual">
                  <div class="paso__foto arco--redondo">
                    <Image src={p.foto} alt={p.alt} widths={[320, 460, 640]} sizes="(max-width: 700px) 78vw, 420px" />
                  </div>
                  <span class:list={['pegatina pegatina--viva paso__pegatina', i === 1 && 'pegatina--albero']} style={`--giro:${[-6, 4, -4, 5][i]}deg`}>
                    {p.pegatina}
                  </span>
                </div>
                <h3 class="paso__titulo">{p.titulo}</h3>
                <p class="paso__texto">{p.texto}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ============================================================ BAJADA A LA BODEGA -->
  <section class="bodega oscuro seccion diferido" aria-labelledby="bodega-titulo">
    <div class="contenedor bodega__rejilla">
      <div class="bodega__texto">
        <p class="antetitulo revela">Criaderas y soleras</p>
        <h2 id="bodega-titulo" class="titular titular--2 revela">
          De ambarino <span class="cursiva bodega__cursiva">a azabache.</span>
        </h2>
        <p class="lectura revela">
          Sometidos a crianza para aumentar lentamente su color en las botas. Color que pasa de ambarino a
          tonalidades casi azabache, con contenidos mínimos en azúcares superiores a los 272 gramos por litro,
          llegando a alcanzar los 415 gramos por litro una vez envejecido.
        </p>
        <div class="crianza revela" aria-hidden="true" data-scroll-x>
          <div class="crianza__barra">
            <span class="crianza__carril"><span class="crianza__bola"></span></span>
          </div>
          <div class="crianza__etiquetas"><span>Ambarino</span><span>Caoba</span><span>Azabache</span></div>
        </div>
        <a class="boton boton--albero revela" href="/produccion">Ver el proceso completo <Icono nombre="flecha" /></a>
      </div>
      <div class="bodega__fotos">
        <Picture
          src={copas}
          formats={['avif', 'webp']}
          class="bodega__copas"
          alt="Cuatro catavinos con vinos de ámbar a azabache sobre una bota"
          widths={[480, 720, 1000, 1280]}
          sizes="(max-width: 900px) 92vw, 640px"
        />
        <div class="bodega__pasillo arco--redondo">
          <Image src={solera2} alt="Pasillo de botas en la bodega" widths={[240, 360, 480]} sizes="240px" />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ 5 ESSENCES -->
  <section class="esencias seccion diferido" id="cinco-esencias" aria-labelledby="esencias-titulo">
    <div class="contenedor">
      <p class="antetitulo revela">Gama de autor · 5 Essences</p>
      <h2 id="esencias-titulo" class="titular titular--1 esencias__titulo revela">Cinco <span class="cursiva">esencias.</span></h2>
      <p class="lectura esencias__entrada revela">
        Desde mediados del siglo pasado hemos ido evolucionando para lograr desarrollar una gama propia de los vinos
        generosos de la Denominación de Origen Protegida Montilla-Moriles.
      </p>

      <div class="bento" data-carrusel>
        <ul class="bento__rejilla" data-pista role="list" data-scroll-x>
          {
            esencias.map((v) => {
              const venta = principal(v);
              return (
                <li class:list={['bloque', `bloque--${v.monograma}`]} data-producto>
                  <div class="bloque__interior">
                  <span class="bloque__mono" aria-hidden="true">{v.monograma}</span>
                  <h3 class="bloque__nombre">
                    <a href={`/vinos/${v.slug}`}>{v.corto}</a>
                  </h3>
                  <p class="bloque__gancho">{v.gancho}</p>
                  <div class="bloque__botella arco--redondo">
                    <Image
                      src={v.imagen}
                      alt=""
                      widths={[160, 240, 360, 480]}
                      sizes="(max-width: 700px) 120px, 220px"
                      transition:name={`botella-${v.slug}`}
                    />
                  </div>
                  <div class="bloque__pie">
                    <span class="precio bloque__precio">{euros((venta ?? v.variaciones[0]!).precio)}</span>
                    {venta ? (
                      <button class="bloque__anadir" type="button" data-anadir data-sku={venta.id} data-nombre={v.corto} aria-label={`Añadir ${v.corto} a la cesta`}>
                        Añadir
                      </button>
                    ) : (
                      <span class="agotado">Agotado</span>
                    )}
                  </div>
                  </div>
                </li>
              );
            })
          }
          <li class="bloque bloque--pack" data-producto>
            <Image src={pack.imagen} alt="Estuche con las cinco botellas 5 Essences" widths={[360, 540, 720]} sizes="(max-width: 700px) 80vw, 25vw" class="bloque__foto" />
            <span class="pegatina pegatina--albero pegatina--viva bloque__pegatina">Pack · {euros(pack.precio)}</span>
            {
              packALaVenta ? (
                <button class="boton boton--claro bloque__comprar-pack" type="button" data-anadir data-sku={pack.sku} data-nombre={pack.nombre}>
                  Comprar las cinco
                </button>
              ) : (
                <a class="boton boton--claro bloque__comprar-pack" href={`/vinos/${pack.slug}`}>Ver el pack</a>
              )
            }
          </li>
        </ul>
        <div class="bento__flechas">
          <button class="boton-icono boton-icono--borde" type="button" data-anterior aria-label="Vino anterior"><Icono nombre="flecha-izq" /></button>
          <button class="boton-icono boton-icono--borde" type="button" data-siguiente aria-label="Vino siguiente"><Icono nombre="flecha" /></button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ MARQUÉS DE LA VEGA -->
  <section class="marques fondo-cal-2 seccion diferido" aria-labelledby="marques-titulo">
    <div class="contenedor marques__rejilla">
      <div class="marques__texto">
        <p class="antetitulo revela">Nuestra enseña · Marqués de la Vega</p>
        <h2 id="marques-titulo" class="titular titular--2 revela">
          <span class="cursiva marques__cursiva">Y el Pedro Ximénez</span> de siempre.
        </h2>
        <p class="lectura revela">
          El Pedro Ximénez es un vino único en el mundo elaborado en las paseras de nuestra Denominación de Origen.
          Estos dos son los nuestros.
        </p>
        <a class="boton revela" href="/vinos">Ver los {vinos.length + 1} vinos</a>
      </div>
      {marques.map((v, i) => <TarjetaVino producto={v} pegatina={i === 0 ? 'La joya de la casa' : undefined} />)}
    </div>
  </section>

  <!-- ============================================================ VISITA -->
  <section class="visita diferido" aria-labelledby="visita-titulo">
    <Picture
      src={patio}
      formats={['avif', 'webp']}
      class="visita__foto"
      alt="Patio del cortijo con las paredes encaladas, el zócalo albero y la torre"
      widths={[640, 1024, 1440, 2000]}
      sizes="100vw"
    />
    <div class="contenedor visita__caja">
      <div class="visita__tarjeta revela">
        <p class="antetitulo">Visítanos</p>
        <h2 id="visita-titulo" class="titular titular--3">La casa, <span class="cursiva">en Montilla.</span></h2>
        <p class="lectura">Av. del Marqués de la Vega de Armijo, 76<br />14550 Montilla, Córdoba</p>
        <div class="visita__acciones">
          <a class="boton boton--primario boton--pequeno" href="/contacto">Contacto</a>
          <a
            class="boton boton--pequeno"
            href="https://www.google.com/maps/search/?api=1&query=Av.%20del%20Marqu%C3%A9s%20de%20la%20Vega%20de%20Armijo%2076%2C%2014550%20Montilla"
            rel="noopener">Cómo llegar <Icono nombre="externo" tam={18} /></a
          >
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------------------------------------------------------------- hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 560px);
    gap: clamp(32px, calc(4vw / var(--zoom)), 56px);
    padding-top: clamp(24px, calc(4vw / var(--zoom)), 56px);
  }

  .hero__texto {
    padding-top: clamp(8px, calc(2vw / var(--zoom)), 24px);
    display: flex;
    flex-direction: column;
  }

  .hero__titulo {
    margin-top: 24px;
  }

  .hero__linea {
    display: block;
  }

  .hero__linea--sol {
    position: relative;
    margin-top: 0.04em;
  }

  .hero__linea--sol .cursiva {
    position: relative;
    font-size: 1.14em;
    line-height: 0.92;
  }

  /* El sol: disco albero detrás de "sol" */
  .hero__sol {
    position: absolute;
    left: 1.42em;
    top: 0.06em;
    width: 1.03em;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--albero);
  }

  .hero__entrada {
    margin-top: 36px;
    max-width: 30rem;
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .hero__visual {
    position: relative;
  }

  .hero__arco {
    aspect-ratio: 560 / 744;
    border: 14px solid var(--albero);
    border-bottom: 0;
    border-radius: 999px 999px 0 0;
    overflow: hidden;
    transform-origin: 50% 100%;
  }

  .hero__arco :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
  }

  .hero__px {
    position: absolute;
    left: -44px;
    top: 20%;
    --giro: -9deg;
    font-size: 3rem;
  }

  .hero__cien {
    position: absolute;
    left: -76px;
    bottom: 13%;
    --giro: 5deg;
  }

  .hero__sello {
    position: absolute;
    right: -28px;
    top: 5%;
    rotate: 12deg;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__sello :global(.sello__aro) {
      animation: gira 26s linear infinite;
    }

    @supports (animation-timeline: scroll()) {
      .hero__sol {
        animation: sol-sube linear both;
        animation-timeline: scroll(root);
        animation-range: 0 calc(70vh / var(--zoom));
      }
      .hero__arco {
        animation: arco-abre linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 90%;
      }
    }
  }

  @keyframes gira {
    to {
      rotate: 360deg;
    }
  }

  @keyframes sol-sube {
    to {
      translate: 0.12em -0.28em;
      scale: 1.12;
      background-color: #e7b54c;
    }
  }

  @keyframes arco-abre {
    to {
      border-radius: 48px 48px 0 0;
      scale: 1.06;
    }
  }

  @media (max-width: 1200px) {
    .hero__sello {
      right: -6px;
    }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero__visual {
      width: min(100%, 520px);
      margin-inline: auto;
    }
    .hero__px {
      left: 4px;
      font-size: 2.2rem;
    }
    .hero__cien {
      left: 4px;
      font-size: 0.95rem;
    }
    .hero__sello {
      right: -6px;
      width: 104px;
    }
    .hero__arco {
      border-width: 10px;
    }
  }

  @media (max-width: 640px) {
    .hero__acciones .boton {
      flex: 1 1 100%;
    }
  }

  /* ---------------------------------------------------------------- cinta */
  .hero-cinta {
    padding-block: clamp(10px, calc(1.6vw / var(--zoom)), 24px);
  }

  .cinta__grande {
    font-size: clamp(2.4rem, calc(5.6vw / var(--zoom)), 5.25rem);
    font-weight: 800;
    letter-spacing: -0.05em;
  }

  .cinta__cursiva {
    font-family: var(--fraunces);
    font-style: italic;
    font-weight: 340;
    font-size: clamp(2.6rem, calc(6vw / var(--zoom)), 5.6rem);
  }

  /* ---------------------------------------------------------------- manifiesto */
  .manifiesto__frase {
    margin-top: 24px;
    max-width: 74rem;
    font-size: clamp(1.9rem, calc(3.2vw / var(--zoom)) + 0.6rem, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .cifras {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: clamp(40px, calc(5vw / var(--zoom)), 72px);
    list-style: none;
    padding: 0;
  }

  .cifra {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    min-height: 300px;
    padding: 32px;
    border-radius: var(--radio);
    overflow: hidden;
  }

  .cifra--albero {
    background: var(--albero);
  }

  .cifra--caoba {
    background: var(--caoba);
    color: var(--cal);
  }

  .cifra--persiana {
    background: var(--persiana);
    color: var(--cal);
  }

  .cifra--foto {
    padding: 0;
  }

  .cifra--foto :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cifra__pegatina {
    position: absolute;
    left: 20px;
    bottom: 20px;
    --giro: -4deg;
    border-color: var(--cal);
  }

  .cifra__pie {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cifra__pie--cursiva {
    font-family: var(--fraunces);
    font-style: italic;
    font-size: 1.6rem;
    font-weight: 320;
    text-transform: none;
    letter-spacing: 0;
    color: var(--caoba-texto);
  }

  .cifra__num {
    font-size: clamp(4.4rem, calc(7vw / var(--zoom)), 7.5rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.85;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 1100px) {
    .cifras {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .cifras {
      gap: 10px;
    }
    .cifra {
      min-height: 200px;
      gap: 24px;
      padding: 20px;
    }
    .cifra__num {
      font-size: calc(12.5vw / var(--zoom));
    }
    .cifra__pie {
      font-size: 0.75rem;
    }
    .cifra__pie--cursiva {
      font-size: 1.2rem;
    }
    .cifra__pegatina {
      left: 10px;
      bottom: 10px;
      font-size: 0.8rem;
      padding: 6px 12px;
    }
  }

  /* ---------------------------------------------------------------- proceso
     Por defecto: carrusel con scroll-snap y flechas. En escritorio con soporte:
     la sección se queda fija y el scroll vertical desliza las tarjetas. */
  .proceso__fijo {
    padding-block: clamp(72px, calc(8vw / var(--zoom)), 104px);
