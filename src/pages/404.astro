---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';

// Servida al momento: así también responde bien si alguien visita /404 a mano.
export const prerender = false;
Astro.response.status = 404;
---

<Base titulo="Página no encontrada" descripcion="Esta página no existe en bodegasgalanportero.com.">
  <section class="perdido contenedor">
    <p class="antetitulo">Error 404</p>
    <h1 class="titular titular--1 perdido__titulo">
      Aquí no <span class="perdido__sol" aria-hidden="true"></span><span class="cursiva">hay nada.</span>
    </h1>
    <p class="lectura">La página que buscas no existe o ha cambiado de sitio. Vuelve a la bodega y sigue por donde quieras.</p>
    <div class="perdido__acciones">
      <a class="boton boton--primario" href="/">Volver al inicio <Icono nombre="flecha" /></a>
      <a class="boton" href="/vinos">Ver los vinos</a>
    </div>
  </section>
</Base>

<style>
  .perdido {
    display: grid;
    justify-items: start;
    gap: 24px;
    padding-block: clamp(48px, calc(10vw / var(--zoom)), 140px);
  }

  .perdido__titulo {
    position: relative;
  }

  .perdido__titulo .cursiva {
    position: relative;
    display: block;
  }

  .perdido__sol {
    position: absolute;
    left: 1.6em;
    bottom: 0.02em;
    width: 0.9em;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--albero);
  }

  .perdido__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
