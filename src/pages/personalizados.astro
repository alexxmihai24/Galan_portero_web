---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PortadaPagina from '../components/PortadaPagina.astro';
import Icono from '../components/Icono.astro';
import { ENVIO_GRATIS_DESDE, pack } from '../data/vinos';
import brindis from '../assets/fotos/woman.jpg';
import cata from '../assets/fotos/woman-wine.jpg';

// Cada ocasión, una pegatina con su color y su giro.
const ocasiones = [
  { texto: 'Bodas', clase: 'pegatina--albero', giro: -6 },
  { texto: 'Comuniones', clase: 'pegatina--persiana', giro: 4 },
  { texto: 'Bautizos', clase: 'oc--am', giro: -3 },
  { texto: 'Empresa', clase: '', giro: 7 },
  { texto: 'Aniversarios', clase: 'oc--ol', giro: -8 },
  { texto: 'Ferias y congresos', clase: 'oc--cr', giro: 3 },
];
const pasos = [
  { titulo: 'Nos escribes', texto: 'Ocasión, número de botellas, fecha y qué vino te gusta. Si no lo tienes claro, te asesoramos.' },
  { titulo: 'Diseñamos la etiqueta', texto: 'Con vuestros nombres, la fecha, un logo de empresa o lo que haga falta. Te la enseñamos antes de imprimir nada.' },
  { titulo: 'Lo preparamos y te llega', texto: `Embotellado, etiquetado y enviado. Envío gratis a península a partir de ${ENVIO_GRATIS_DESDE} €.` },
];
---

<Base
  titulo="Productos personalizados"
  descripcion="Botellas de Bodegas Galán Portero con etiqueta personalizada para bodas, comuniones, empresas y celebraciones. Pide presupuesto sin compromiso."
>
  <PortadaPagina antetitulo="Para tu evento especial" imagen={pack.imagen} alt="Las cinco botellas de 5 Essences, con la etiqueta a la vista" pegatina="Sin compromiso">
    <Fragment slot="titulo">Con vuestro nombre <span class="cursiva">en la etiqueta.</span></Fragment>
    <p>El mismo vino de siempre, con la etiqueta que vosotros queráis. Un detalle que se bebe y que la gente recuerda.</p>
    <Fragment slot="acciones">
      <a class="boton boton--primario" href="/contacto">Pedir presupuesto <Icono nombre="flecha" /></a>
      <a class="boton" href="tel:+34957664237">957 66 42 37</a>
    </Fragment>
  </PortadaPagina>

  <section class="ocasiones fondo-cal-2 seccion" aria-labelledby="ocasiones-titulo">
    <div class="contenedor">
      <p class="antetitulo">Celebraciones y eventos</p>
      <h2 id="ocasiones-titulo" class="titular titular--2 ocasiones__titulo">Para qué <span class="cursiva">se suele pedir.</span></h2>
      <ul class="ocasiones__lista" role="list">
        {
          ocasiones.map((o) => (
            <li class={`pegatina pegatina--viva ${o.clase}`} style={`--giro:${o.giro}deg`}>
              {o.texto}
            </li>
          ))
        }
      </ul>
      <p class="lectura">
        Cuéntanos cuántas botellas necesitas, para cuándo y qué quieres que ponga la etiqueta. Te decimos precio y plazo sin
        compromiso.
      </p>
    </div>
  </section>

  <section class="seccion contenedor" aria-labelledby="pasos-titulo">
    <p class="antetitulo">Así de sencillo</p>
    <h2 id="pasos-titulo" class="titular titular--2 pasos__titulo">Cómo <span class="cursiva">funciona.</span></h2>
    <ol class="pasos" role="list">
      {
        pasos.map((p, i) => (
          <li class="paso revela">
            <span class="paso__num">0{i + 1}</span>
            <h3 class="paso__titulo">{p.titulo}</h3>
            <p class="paso__texto">{p.texto}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="cierre oscuro seccion" aria-labelledby="cierre-titulo">
    <div class="contenedor cierre__rejilla">
      <div class="cierre__fotos">
        <div class="cierre__foto arco--redondo"><Image src={brindis} alt="Dos personas brindando con vino" widths={[360, 540]} sizes="(max-width: 900px) 45vw, 280px" /></div>
        <div class="cierre__foto arco--redondo"><Image src={cata} alt="Mujer catando una copa de vino generoso" widths={[360, 540]} sizes="(max-width: 900px) 45vw, 280px" /></div>
      </div>
      <div class="cierre__texto">
        <p class="antetitulo">Sin compromiso</p>
        <h2 id="cierre-titulo" class="titular titular--2">Cuéntanos <span class="cursiva">qué necesitas.</span></h2>
        <p class="lectura">Te preparamos un presupuesto adaptado al número de botellas y al diseño que queráis.</p>
        <div class="cierre__acciones">
          <a class="boton boton--albero" href="/contacto">Escribir a la bodega <Icono nombre="flecha" /></a>
          <a class="boton boton--contorno-claro" href="tel:+34957664237">957 66 42 37</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .ocasiones__titulo,
  .pasos__titulo {
    margin-top: 16px;
  }

  .ocasiones__lista {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 12px;
    margin: 40px 0 32px;
    list-style: none;
    padding: 0;
  }

  .ocasiones__lista .pegatina {
    border-color: var(--cal-2);
    font-size: clamp(1.3rem, calc(2.4vw / var(--zoom)), 2.2rem);
    padding: 10px 26px;
  }

  .oc--am {
    background: var(--am);
  }
  .oc--ol {
    background: var(--ol);
  }
  .oc--cr {
    background: var(--cr);
    color: var(--hierro);
  }

  .pasos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 40px;
    list-style: none;
    padding: 0;
  }

  .paso {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 32px;
    border-radius: var(--radio-g);
    background: var(--blanco);
  }

  .paso__num {
    font-family: var(--fraunces);
    font-style: italic;
    font-weight: 320;
    font-size: 4.5rem;
    line-height: 0.8;
    color: var(--albero-osc);
  }

  .paso__titulo {
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .paso__texto {
    color: var(--texto-2);
    line-height: 1.55;
  }

  .cierre__rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, calc(5vw / var(--zoom)), 72px);
    align-items: center;
  }

  .cierre__fotos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .cierre__foto {
    aspect-ratio: 3 / 4;
  }

  .cierre__foto:nth-child(2) {
    margin-top: 48px;
  }

  .cierre__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cierre__texto {
    display: grid;
    justify-items: start;
    gap: 22px;
  }

  .cierre__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 900px) {
    .pasos,
    .cierre__rejilla {
      grid-template-columns: 1fr;
    }
  }
</style>
