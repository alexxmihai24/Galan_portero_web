---
import Base from '../../layouts/Base.astro';
import TarjetaVino from '../../components/TarjetaVino.astro';
import Icono from '../../components/Icono.astro';
import { catalogo } from '../../lib/catalogo';
import { ENVIO_GRATIS_DESDE } from '../../data/vinos';

export const prerender = false;

const { vinos, pack } = await catalogo();
const orden = [...vinos.filter((v) => v.gama === 'Marqués de la Vega'), ...vinos.filter((v) => v.gama === '5 Essences')];

const filtros = [
  { id: 'todos', texto: 'Todos' },
  { id: 'pedro-ximenez', texto: 'Pedro Ximénez' },
  { id: '5-essences', texto: '5 Essences' },
  { id: 'secos', texto: 'Secos' },
  { id: 'dulces', texto: 'Dulces' },
  { id: 'packs', texto: 'Packs' },
];
const total = orden.length + 1;
---

<Base
  titulo="Nuestros vinos"
  descripcion="Compra online los vinos de Bodegas Galán Portero: Pedro Ximénez Solera Fundador, Cosecha, la gama 5 Essences y el pack. Envío gratis a península desde 100 €."
>
  <section class="catalogo contenedor" aria-labelledby="catalogo-titulo">
    <header class="catalogo__cabeza">
      <div>
        <p class="antetitulo">Tienda online · <span style="white-space: nowrap">D.O.P. Montilla-Moriles</span></p>
        <h1 id="catalogo-titulo" class="titular titular--1 catalogo__titulo">Nuestros <span class="cursiva">vinos.</span></h1>
      </div>
      <p class="lectura catalogo__entrada">
        Dos Pedro Ximénez de la casa y cinco generosos que puedes catar juntos en un solo pack. Todos se crían en
        nuestra bodega de Montilla.
      </p>
    </header>

    <div class="filtros" data-filtros role="group" aria-label="Filtrar vinos" data-scroll-x>
      {
        filtros.map((f, i) => (
          <button class="filtro" type="button" data-filtro={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.texto}
          </button>
        ))
      }
      <p class="filtros__cuenta" data-cuenta-filtro aria-live="polite">{total} vinos</p>
    </div>

    <h2 class="oculto-visual">Vinos a la venta</h2>
    <ul class="rejilla" role="list" data-rejilla>
      {orden.map((v, i) => <li><TarjetaVino producto={v} prioridad={i < 4} pegatina={i === 0 ? 'La joya de la casa' : undefined} /></li>)}
      <li><TarjetaVino producto={pack} pegatina="Las cinco juntas" /></li>
    </ul>
  </section>

  <div class="zocalo catalogo__zocalo">
    <div class="contenedor catalogo__zocalo-interior">
      <Icono nombre="sol" tam={36} />
      <p><strong>Envío gratis a península</strong> <span class="cursiva">desde {ENVIO_GRATIS_DESDE}&nbsp;€.</span></p>
      <a class="boton boton--primario boton--pequeno" href="/cesta">Ver la cesta</a>
    </div>
  </div>
</Base>

<script>
  function montarFiltros() {
    const caja = document.querySelector<HTMLElement>('[data-filtros]');
    const rejilla = document.querySelector<HTMLElement>('[data-rejilla]');
    if (!caja || !rejilla) return;
    const botones = [...caja.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
    const cuenta = caja.querySelector<HTMLElement>('[data-cuenta-filtro]')!;

    const aplicar = (id: string) => {
      const cambiar = () => {
        let n = 0;
        for (const li of rejilla.children as HTMLCollectionOf<HTMLElement>) {
          const tipos = li.querySelector<HTMLElement>('[data-tipos]')?.dataset.tipos?.split(' ') ?? [];
          const ver = id === 'todos' || tipos.includes(id);
          li.hidden = !ver;
          if (ver) n++;
        }
        for (const b of botones) b.setAttribute('aria-pressed', String(b.dataset.filtro === id));
        cuenta.textContent = `${n} ${n === 1 ? 'vino' : 'vinos'}`;
      };
      // Las tarjetas se recolocan animadas donde el navegador lo sabe hacer.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (document.startViewTransition && !reduce) document.startViewTransition(cambiar);
      else cambiar();
    };

    caja.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filtro]');
      if (!b) return;
      aplicar(b.dataset.filtro!);
      history.replaceState(history.state, '', b.dataset.filtro === 'todos' ? location.pathname : `#${b.dataset.filtro}`);
    });

    const inicial = location.hash.slice(1);
    if (botones.some((b) => b.dataset.filtro === inicial)) aplicar(inicial);
  }
  document.addEventListener('astro:page-load', montarFiltros);
</script>

<style>
  .catalogo {
    padding-block: clamp(32px, calc(5vw / var(--zoom)), 72px) clamp(64px, calc(8vw / var(--zoom)), 112px);
  }

  .catalogo__cabeza {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    align-items: end;
    gap: 24px 48px;
  }

  .catalogo__titulo {
    margin-top: 16px;
  }

  .filtros {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: clamp(28px, calc(4vw / var(--zoom)), 48px);
  }

  .filtro {
    min-height: 44px;
    padding: 0 20px;
    border: 2px solid rgba(23, 20, 18, 0.2);
    border-radius: 999px;
    background: transparent;
    font-size: 0.9375rem;
    font-weight: 700;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s;
  }

  .filtro:hover {
    border-color: var(--hierro);
  }

  .filtro[aria-pressed='true'] {
    background: var(--hierro);
    border-color: var(--hierro);
    color: var(--cal);
  }

  .filtros__cuenta {
    margin-left: auto;
    font-family: var(--fraunces);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--texto-2);
  }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, calc(2vw / var(--zoom)), 24px);
    margin-top: 32px;
    list-style: none;
    padding: 0;
  }

  .rejilla > li {
    display: flex;
  }

  .rejilla > li > :global(.tarjeta) {
    flex: 1;
  }

  .catalogo__zocalo-interior {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    padding-block: 28px;
    font-size: clamp(1.4rem, calc(2.4vw / var(--zoom)), 2.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .catalogo__zocalo-interior p {
    flex: 1;
  }

  @media (max-width: 1100px) {
    .rejilla {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 800px) {
    .catalogo__cabeza {
      grid-template-columns: 1fr;
    }
    .rejilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .filtros {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-right: calc(var(--margen) * -1);
      padding-right: var(--margen);
      scrollbar-width: none;
    }
    .filtro {
      flex-shrink: 0;
    }
    .filtros__cuenta {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }
</style>
