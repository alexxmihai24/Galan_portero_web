---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import TarjetaVino from '../../components/TarjetaVino.astro';
import { catalogo, type VariacionTienda } from '../../lib/catalogo';
import { ENVIO_GRATIS_DESDE, euros } from '../../data/vinos';
import solera from '../../assets/fotos/solera-2.jpg';

export const prerender = false;

const { vinos, pack } = await catalogo();
const slug = Astro.params.slug;
const vino = vinos.find((v) => v.slug === slug);
const esPack = slug === pack.slug;
if (!vino && !esPack) return new Response(null, { status: 404 }); // Astro pinta 404.astro

type Opcion = { sku: number; etiqueta: string; formato: string; precio: number; disponible: boolean };
const opciones: Opcion[] = vino
  ? vino.variaciones.map((x: VariacionTienda) => ({
      sku: x.id,
      etiqueta: x.etiqueta,
      formato: x.formato,
      precio: x.precio,
      disponible: x.activo && x.stock !== 0,
    }))
  : [{ sku: pack.sku, etiqueta: 'Estuche', formato: 'Las cinco botellas', precio: pack.precio, disponible: pack.activo && pack.stock !== 0 }];
const elegida = opciones.find((o) => o.disponible) ?? opciones[0]!;
const hayVenta = opciones.some((o) => o.disponible);

const nombre = vino ? vino.corto : pack.nombre;
const imagen = vino?.recorte ?? (vino ? vino.imagen : pack.imagen);
const recorte = Boolean(vino?.recorte);
const otros = [...vinos.filter((v) => v.slug !== slug)].slice(0, esPack ? 4 : 3);
const esencias = vinos.filter((v) => v.gama === '5 Essences');

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: vino ? vino.nombre : pack.nombre,
  description: vino ? vino.resumen : pack.resumen,
  brand: { '@type': 'Brand', name: vino ? vino.gama : '5 Essences' },
  offers: opciones.map((o) => ({
    '@type': 'Offer',
    name: o.formato,
    price: o.precio.toFixed(2),
    priceCurrency: 'EUR',
    availability: o.disponible ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
    url: new URL(Astro.url.pathname, Astro.site).href,
  })),
};
---

<Base titulo={nombre} descripcion={vino ? `${vino.nombre}. ${vino.gancho}` : pack.gancho}>
  <article class="ficha contenedor" data-producto>
    <nav class="migas" aria-label="Estás en">
      <a href="/vinos">Vinos</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{nombre}</span>
    </nav>

    <div class="ficha__rejilla">
      <div class="ficha__visual">
        <div class:list={['nicho ficha__nicho', !recorte && 'nicho--oscuro']}>
          <Image
            src={imagen}
            class={recorte ? 'recorte' : 'foto'}
            alt={`Botella de ${vino ? vino.nombre : pack.nombre}`}
            widths={recorte ? [260, 420, 600] : [480, 720, 1000]}
            sizes="(max-width: 900px) 90vw, 520px"
            loading="eager"
            fetchpriority="high"
            transition:name={`botella-${slug}`}
          />
        </div>
        {vino?.monograma && <span class:list={['pegatina pegatina--mono ficha__mono', `mono--${vino.monograma}`]} aria-hidden="true">{vino.monograma}</span>}
        {vino?.slug === 'pedro-ximenez-solera-fundador' && <span class="pegatina pegatina--albero ficha__joya">La joya de la casa</span>}
      </div>

      <div class="ficha__info">
        <ul class="ficha__etiquetas" role="list">
          <li>{vino ? vino.gama : '5 Essences'}</li>
          {vino && <li>{vino.estilo}</li>}
          <li>D.O.P. Montilla-Moriles</li>
        </ul>
        <h1 class="titular titular--2 ficha__titulo">{nombre}</h1>
        <p class="ficha__gancho">{vino ? vino.gancho : pack.gancho}</p>
        <p class="lectura">{vino ? vino.resumen : pack.resumen}</p>

        <form class="compra" data-form-compra data-nombre={nombre}>
          {
            vino ? (
              <fieldset class="compra__formatos">
                <legend class="etiqueta-campo">Formato</legend>
                {opciones.map((o) => (
                  <label class="formato">
                    <input type="radio" name="sku" value={o.sku} data-precio={o.precio} checked={o.sku === elegida.sku} disabled={!o.disponible} />
                    <span class="formato__etiqueta">{o.etiqueta}</span>
                    <span class="formato__detalle">{o.formato}</span>
                    <span class="formato__precio precio">{o.disponible ? euros(o.precio) : 'Agotado'}</span>
                  </label>
                ))}
              </fieldset>
            ) : (
              <input type="hidden" name="sku" value={pack.sku} data-precio={pack.precio} />
            )
          }

          <div class="compra__fila">
            <div class="cantidad">
              <label class="etiqueta-campo" for="unidades">Unidades</label>
              <div class="cantidad__mandos">
                <button class="boton-icono" type="button" data-restar aria-label="Una unidad menos"><Icono nombre="menos" /></button>
                <input id="unidades" name="unidades" type="number" inputmode="numeric" min="1" max="99" value="1" />
                <button class="boton-icono" type="button" data-sumar aria-label="Una unidad más"><Icono nombre="mas" /></button>
              </div>
            </div>
            <p class="compra__total">
              <span class="etiqueta-campo">Total</span>
              <output class="precio" data-total>{euros(elegida.precio)}</output>
            </p>
          </div>

          <button class="boton boton--comprar boton--bloque compra__boton" type="submit" disabled={!hayVenta}>
            <Icono nombre="mas" />
            {hayVenta ? 'Añadir a la cesta' : 'Agotado'}
          </button>
        </form>

        <ul class="garantias" role="list">
          <li><Icono nombre="sol" tam={20} /> Envío gratis a península desde {ENVIO_GRATIS_DESDE}&nbsp;€</li>
          <li><Icono nombre="bolsa" tam={20} /> Pago seguro con tarjeta (Stripe)</li>
          <li><Icono nombre="usuario" tam={20} /> Sigue tu pedido desde tu cuenta</li>
        </ul>
      </div>
    </div>
  </article>

  {
    vino ? (
      <section class="cata fondo-cal-2 seccion" aria-labelledby="cata-titulo">
        <div class="contenedor">
          <p class="antetitulo revela">Nota de cata oficial</p>
          <h2 id="cata-titulo" class="titular titular--2 revela">
            Análisis <span class="cursiva">sensorial.</span>
          </h2>
          <dl class="cata__rejilla">
            <div class="cata__bloque cata__bloque--color revela">
              <dt class="antetitulo">Color</dt>
              <dd>{vino.cata.color}</dd>
            </div>
            <div class="cata__bloque revela">
              <dt class="antetitulo">Nariz</dt>
              <dd>{vino.cata.aroma}</dd>
            </div>
            <div class="cata__bloque revela">
              <dt class="antetitulo">Boca</dt>
              <dd>{vino.cata.boca}</dd>
            </div>
            <div class="cata__bloque cata__bloque--crianza revela">
              <dt class="antetitulo">Crianza</dt>
              <dd>{vino.crianza}</dd>
            </div>
          </dl>
        </div>
      </section>
    ) : (
      <section class="cata fondo-cal-2 seccion" aria-labelledby="incluye-titulo">
        <div class="contenedor">
          <p class="antetitulo">Lo que hay dentro</p>
          <h2 id="incluye-titulo" class="titular titular--2">
            Las cinco <span class="cursiva">esencias.</span>
          </h2>
          <ul class="incluye" role="list">
            {esencias.map((v) => (
              <li>
                <a class:list={['incluye__vino', `mono--${v.monograma}`]} href={`/vinos/${v.slug}`}>
                  <span class="incluye__mono" aria-hidden="true">{v.monograma}</span>
                  <span class="incluye__nombre">{v.corto}</span>
                  <span class="incluye__gancho">{v.gancho}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="soleras oscuro" aria-labelledby="soleras-titulo">
    <div class="contenedor soleras__rejilla">
      <div class="soleras__foto arco--redondo">
        <Image src={solera} alt="Pasillo de botas de roble en la bodega" widths={[320, 480, 640]} sizes="(max-width: 800px) 70vw, 360px" />
      </div>
      <div class="soleras__texto">
        <p class="antetitulo">Criaderas y soleras</p>
        <h2 id="soleras-titulo" class="titular titular--2">El vino baja <span class="cursiva">de escala en escala.</span></h2>
        <p class="lectura">
          Se saca de la solera, la fila que toca el suelo, y esa se rellena con la criadera de encima. Así hasta
          arriba. Ningún año se embotella solo: cada botella lleva un poco de todos los anteriores.
        </p>
        <a class="boton boton--albero" href="/produccion">Ver el proceso <Icono nombre="flecha" /></a>
      </div>
    </div>
  </section>

  <section class="seccion contenedor" aria-labelledby="otros-titulo">
    <p class="antetitulo">Explora la bodega</p>
    <h2 id="otros-titulo" class="titular titular--2 otros__titulo">También <span class="cursiva">de la casa.</span></h2>
    <ul class="otros" role="list">
      {otros.map((v) => <li><TarjetaVino producto={v} /></li>)}
      {!esPack && <li><TarjetaVino producto={pack} /></li>}
    </ul>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
</Base>

<script>
  import { euros } from '../../lib/pedido.ts';

  function montarCompra() {
    const form = document.querySelector<HTMLFormElement>('[data-form-compra]');
    if (!form) return;
    const unidades = form.querySelector<HTMLInputElement>('input[name="unidades"]')!;
    const total = form.querySelector<HTMLOutputElement>('[data-total]')!;
    const actualizar = () => {
      const n = Math.max(1, Math.min(99, Math.round(Number(unidades.value) || 1)));
      unidades.value = String(n);
      const sel = form.querySelector<HTMLInputElement>('input[name="sku"]:checked, input[name="sku"][type="hidden"]');
      total.textContent = euros(Math.round(Number(sel?.dataset.precio ?? 0) * 100) * n);
    };
    form.addEventListener('change', actualizar);
    form.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-sumar]')) unidades.value = String(Number(unidades.value) + 1);
      else if (t.closest('[data-restar]')) unidades.value = String(Number(unidades.value) - 1);
      else return;
      actualizar();
    });
    actualizar();
  }
  document.addEventListener('astro:page-load', montarCompra);
</script>

<style>
  .ficha {
    padding-block: 24px clamp(64px, 8vw, 112px);
  }

  .migas {
    display: flex;
    gap: 10px;
    font-size: 0.9375rem;
    color: var(--texto-2);
  }

  .migas a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-weight: 700;
    color: var(--hierro);
  }

  .ficha__rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
    margin-top: 24px;
    align-items: start;
  }

  .ficha__visual {
    position: sticky;
    top: 112px;
  }

  .ficha__nicho {
    aspect-ratio: 520 / 640;
    background: var(--cal-2);
  }

  .ficha__nicho.nicho--oscuro {
    background: #1e1c1a;
  }

  .ficha__mono {
    position: absolute;
    top: 12%;
    left: -14px;
    --giro: -8deg;
    border-color: var(--cal);
    color: var(--blanco);
    font-size: 3rem;
  }

  .ficha__joya {
    position: absolute;
    top: 10%;
    right: -14px;
    --giro: 8deg;
  }

  .mono--am {
    background: var(--am);
  }
  .mono--pc {
    background: var(--pc);
  }
  .mono--ol {
    background: var(--ol);
  }
  .mono--cr {
    background: var(--cr);
    color: var(--hierro);
  }
  .mono--px {
    background: var(--px);
  }

  .ficha__info {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ficha__etiquetas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
  }

  .ficha__etiquetas li {
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--cal-2);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .ficha__titulo {
    font-size: clamp(3rem, 5.5vw, 5.5rem);
  }

  .ficha__gancho {
    font-family: var(--fraunces);
    font-style: italic;
    font-size: clamp(1.3rem, 1.2vw + 0.9rem, 1.75rem);
    line-height: 1.3;
    color: var(--albero-osc);
  }

  /* --- compra --- */
  .compra {
    display: grid;
    gap: 20px;
    padding: clamp(20px, 3vw, 32px);
    border-radius: var(--radio-g);
    background: var(--blanco);
  }

  .compra__formatos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .compra__formatos legend {
    margin-bottom: 10px;
  }

  .formato {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 16px 18px;
    border: 2px solid rgba(23, 20, 18, 0.15);
    border-radius: 20px;
    cursor: pointer;
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }

  .formato:hover {
    border-color: rgba(23, 20, 18, 0.4);
  }

  .formato:has(input:checked) {
    border-color: var(--persiana);
    background: #eef3ef;
  }

  .formato:has(input:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .formato:has(input:focus-visible) {
    outline: 3px solid var(--persiana);
    outline-offset: 3px;
  }

  .formato input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: inherit;
  }

  .formato__etiqueta {
    font-weight: 800;
  }

  .formato__detalle {
    font-size: 0.875rem;
    color: var(--texto-2);
  }

  .formato__precio {
    margin-top: 8px;
    font-size: 1.25rem;
  }

  .compra__fila {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
  }

  .cantidad {
    display: grid;
    gap: 8px;
  }

  .cantidad__mandos {
    display: flex;
    align-items: center;
    border: 2px solid rgba(23, 20, 18, 0.18);
    border-radius: 999px;
    width: fit-content;
  }

  .cantidad__mandos input {
    width: 3.2ch;
    border: 0;
    background: transparent;
    text-align: center;
    font-size: 1.125rem;
    font-weight: 800;
    -moz-appearance: textfield;
  }

  .cantidad__mandos input::-webkit-inner-spin-button,
  .cantidad__mandos input::-webkit-outer-spin-button {
    -webkit-appearance: none;
  }

  .compra__total {
    display: grid;
    justify-items: end;
    gap: 2px;
  }

  .compra__total output {
    font-size: 2.2rem;
    line-height: 1;
  }

  .compra__boton:disabled {
    opacity: 0.45;
  }

  .garantias {
    display: grid;
    gap: 10px;
    list-style: none;
    padding: 0;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .garantias li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .garantias :global(svg) {
    color: var(--albero-osc);
  }

  /* --- cata --- */
  .cata__rejilla {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 40px;
  }

  .cata__bloque {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: 28px;
    border-radius: var(--radio);
    background: var(--blanco);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .cata__bloque--color {
    background: var(--caoba);
    color: var(--cal);
  }

  .cata__bloque--color .antetitulo {
    color: var(--albero);
  }

  .cata__bloque--crianza {
    grid-column: 1 / -1;
    background: var(--albero);
  }

  .cata__bloque--crianza .antetitulo {
    color: var(--hierro);
  }

  .incluye {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    margin-top: 40px;
    list-style: none;
    padding: 0;
  }

  .incluye__vino {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    padding: 24px;
    border-radius: var(--radio);
    color: var(--blanco);
    text-decoration: none;
    transition: transform 0.3s var(--curva);
  }

  .incluye__vino:hover {
    transform: translateY(-4px);
  }

  .incluye__mono {
    font-family: var(--fraunces);
    font-style: italic;
    font-size: 4.5rem;
    line-height: 0.8;
  }

  .incluye__nombre {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .incluye__gancho {
    font-size: 0.9375rem;
  }

  /* --- soleras --- */
  .soleras {
    padding-block: clamp(64px, 8vw, 104px);
  }

  .soleras__rejilla {
    display: grid;
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .soleras__foto {
    aspect-ratio: 360 / 460;
  }

  .soleras__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .soleras__texto {
    display: grid;
    justify-items: start;
    gap: 24px;
  }

  /* --- otros --- */
  .otros__titulo {
    margin-top: 16px;
  }

  .otros {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 2vw, 24px);
    margin-top: 40px;
    list-style: none;
    padding: 0;
  }

  .otros > li {
    display: flex;
  }

  .otros > li > :global(.tarjeta) {
    flex: 1;
  }

  @media (max-width: 1100px) {
    .otros {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .incluye {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cata__rejilla {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 900px) {
    .ficha__rejilla {
      grid-template-columns: 1fr;
    }
    .ficha__visual {
      position: relative;
      top: 0;
      width: min(100%, 420px);
      margin-inline: auto;
    }
    .ficha__mono {
      left: 0;
      font-size: 2.2rem;
    }
    .ficha__joya {
      right: 0;
    }
    .soleras__rejilla {
      grid-template-columns: 1fr;
    }
    .soleras__foto {
      width: min(70%, 300px);
    }
  }

  @media (max-width: 420px) {
    .compra__formatos {
      grid-template-columns: 1fr;
    }
  }
</style>
