---
import Base from '../layouts/Base.astro';
import PortadaPagina from '../components/PortadaPagina.astro';
import Icono from '../components/Icono.astro';
import fachada from '../assets/fotos/lagar-montilla.jpg';

const sedes = [
  {
    nombre: 'Bodega principal',
    direccion: ['Av. del Marqués de la Vega de Armijo, 76', '14550 Montilla, Córdoba'],
    consulta: 'Av. del Marqués de la Vega de Armijo 76, 14550 Montilla, Córdoba',
  },
  {
    nombre: 'Lagar El Puntal',
    direccion: ['Carretera A-3130, km 24', '14550 Montilla, Córdoba'],
    consulta: 'Carretera A-3130 km 24, 14550 Montilla, Córdoba',
  },
];
const mapa = (consulta: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(consulta)}`;
---

<Base
  titulo="Contacto"
  descripcion="Bodegas Galán Portero en Montilla (Córdoba). Teléfono 957 66 42 37, info@bodegasgalanportero.com. Bodega en Av. Marqués de la Vega de Armijo 76 y Lagar El Puntal en la A-3130."
>
  <PortadaPagina antetitulo="Estamos en Montilla" imagen={fachada} alt="Fachada de la bodega en Montilla, con el portón y el zócalo amarillo">
    <Fragment slot="titulo">Escríbe<span class="cursiva">nos.</span></Fragment>
    <p>Cualquier duda sobre los vinos, los envíos o un pedido para un evento: encantados de atenderte.</p>
    <Fragment slot="acciones">
      <a class="directo" href="tel:+34957664237"><span class="antetitulo">Teléfono</span>957 66 42 37</a>
      <a class="directo" href="mailto:info@bodegasgalanportero.com"><span class="antetitulo">Correo</span>info@bodegasgalanportero.com</a>
    </Fragment>
  </PortadaPagina>

  <section class="fondo-cal-2 seccion" aria-labelledby="sedes-titulo">
    <div class="contenedor">
      <p class="antetitulo">Instalaciones</p>
      <h2 id="sedes-titulo" class="titular titular--2 sedes__titulo">Dónde <span class="cursiva">encontrarnos.</span></h2>
      <ul class="sedes" role="list">
        {
          sedes.map((s) => (
            <li class="sede revela">
              <h3 class="sede__nombre">{s.nombre}</h3>
              <address class="sede__dir">
                {s.direccion.map((l) => (
                  <span>{l}</span>
                ))}
              </address>
              <a class="boton boton--primario boton--pequeno" href={mapa(s.consulta)} target="_blank" rel="noopener noreferrer">
                Abrir en Google Maps <Icono nombre="externo" tam={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="seccion contenedor formulario-seccion" aria-labelledby="form-titulo">
    <div class="formulario__texto">
      <p class="antetitulo">Atención al cliente</p>
      <h2 id="form-titulo" class="titular titular--2">Envíanos <span class="cursiva">un mensaje.</span></h2>
      <p class="lectura">
        Rellena los campos y se abrirá tu programa de correo con el mensaje ya preparado, listo para enviar a
        info@bodegasgalanportero.com.
      </p>
    </div>
    <form class="formulario" data-formulario>
      <div class="campo">
        <label for="nombre">Nombre completo</label>
        <input id="nombre" name="nombre" type="text" required autocomplete="name" />
      </div>
      <div class="campo">
        <label for="correo">Correo electrónico</label>
        <input id="correo" name="correo" type="email" required autocomplete="email" />
      </div>
      <div class="campo">
        <label for="telefono">Teléfono <span class="campo__ayuda">(opcional)</span></label>
        <input id="telefono" name="telefono" type="tel" autocomplete="tel" />
      </div>
      <div class="campo">
        <label for="asunto">Motivo</label>
        <select id="asunto" name="asunto">
          <option>Consulta sobre un vino</option>
          <option>Pedido y envíos</option>
          <option>Productos personalizados para un evento</option>
          <option>Visita a la bodega</option>
          <option>Otra cosa</option>
        </select>
      </div>
      <div class="campo campo--ancho">
        <label for="mensaje">Mensaje</label>
        <textarea id="mensaje" name="mensaje" rows="6" required></textarea>
      </div>
      <div class="campo--ancho formulario__pie">
        <button class="boton boton--primario" type="submit">Preparar el correo <Icono nombre="flecha" /></button>
        <p class="campo__ayuda">Tus datos solo se usan para responderte. También puedes llamarnos al 957 66 42 37.</p>
      </div>
    </form>
  </section>
</Base>

<script>
  function montarFormulario() {
    const form = document.querySelector<HTMLFormElement>('[data-formulario]');
    if (!form) return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const d = new FormData(form);
      const val = (k: string) => String(d.get(k) ?? '').trim();
      const lineas = [`Nombre: ${val('nombre')}`, `Correo: ${val('correo')}`];
      if (val('telefono')) lineas.push(`Teléfono: ${val('telefono')}`);
      const cuerpo = [...lineas, '', val('mensaje')].join('\n');
      location.href = `mailto:info@bodegasgalanportero.com?subject=${encodeURIComponent(val('asunto'))}&body=${encodeURIComponent(cuerpo)}`;
    });
  }
  document.addEventListener('astro:page-load', montarFormulario);
</script>

<style>
  .directo {
    display: grid;
    gap: 4px;
    padding: 16px 22px;
    border-radius: 20px;
    background: var(--blanco);
    font-size: clamp(1.1rem, 1.4vw, 1.4rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition: transform 0.25s var(--curva);
  }

  .directo:hover {
    transform: translateY(-2px);
  }

  .sedes__titulo {
    margin-top: 16px;
  }

  .sedes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 40px;
    list-style: none;
    padding: 0;
  }

  .sede {
    display: grid;
    justify-items: start;
    gap: 16px;
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--radio-g);
    background: var(--blanco);
  }

  .sede__nombre {
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .sede__dir {
    display: grid;
    font-style: normal;
    color: var(--texto-2);
    line-height: 1.6;
  }

  .formulario-seccion {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .formulario__texto {
    display: grid;
    gap: 20px;
  }

  .formulario {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--radio-g);
    background: var(--blanco);
  }

  .campo--ancho {
    grid-column: 1 / -1;
  }

  .formulario__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .formulario__pie .campo__ayuda {
    flex: 1;
    min-width: 14rem;
  }

  @media (max-width: 900px) {
    .sedes,
    .formulario-seccion,
    .formulario {
      grid-template-columns: 1fr;
    }
  }
</style>
