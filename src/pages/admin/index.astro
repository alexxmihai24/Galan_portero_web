---
import Base from '../../layouts/Base.astro';
import NavAdmin from '../../components/NavAdmin.astro';
import Miniatura from '../../components/Miniatura.astro';
import { articulos } from '../../lib/catalogo';
import { euros } from '../../lib/pedido';
import { fecha, listarPedidos, resumenAdmin } from '../../lib/pedidos';

export const prerender = false; // el middleware exige rol admin

const [r, pagados, catalogo] = await Promise.all([resumenAdmin(), listarPedidos('pagado'), articulos()]);
const hora = Number(new Date().toLocaleString('es-ES', { hour: 'numeric', hour12: false, timeZone: 'Europe/Madrid' }));
const [saludo, momento] = hora < 14 ? ['Buenos', 'días.'] : hora < 21 ? ['Buenas', 'tardes.'] : ['Buenas', 'noches.'];
const porEnviar = pagados.reverse(); // los más antiguos primero
const stockBajo = [...catalogo.values()].filter((a) => a.activo && a.stock !== null && a.stock <= 6).sort((a, b) => a.stock! - b.stock!);
---

<Base titulo="Panel" descripcion="Panel de administración" privada>
  <section class="admin contenedor">
    <NavAdmin titulo={saludo} cursiva={momento} />

    <ul class="stats" role="list">
      <li class="stat stat--albero"><span class="stat__pie">Pedidos por enviar</span><span class="stat__num">{r.porEnviar}</span></li>
      <li class="stat stat--persiana"><span class="stat__pie">Ventas este mes</span><span class="stat__num stat__num--dinero">{euros(r.ventasMesCent)}</span></li>
      <li class="stat"><span class="stat__pie">Pedidos este mes</span><span class="stat__num">{r.pedidosMes}</span></li>
      <li class="stat"><span class="stat__pie">Clientes</span><span class="stat__num">{r.clientes}</span></li>
    </ul>

    <div class="admin__rejilla">
      <section aria-labelledby="enviar-titulo">
        <h2 id="enviar-titulo" class="titular titular--3">Por <span class="cursiva">enviar</span></h2>
        {
          porEnviar.length === 0 ? (
            <p class="aviso aviso--ok admin__vacio">No hay pedidos pendientes de envío.</p>
          ) : (
            <div class="tabla-caja admin__tabla">
              <table class="tabla">
                <thead>
                  <tr><th>Pedido</th><th>Pagado</th><th>Cliente</th><th class="num">Total</th><th><span class="oculto-visual">Acción</span></th></tr>
                </thead>
                <tbody>
                  {porEnviar.map((p) => (
                    <tr>
                      <td><strong>nº {p.id}</strong></td>
                      <td>{p.pagado ? fecha(p.pagado, true) : '—'}</td>
                      <td>{p.cliente}</td>
                      <td class="num">{euros(p.total_cent)}</td>
                      <td class="num"><a class="boton boton--primario boton--pequeno" href={`/admin/pedidos/${p.id}`}>Preparar</a></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
      </section>

      <aside class="admin__lado" aria-labelledby="stock-titulo">
        <h2 id="stock-titulo" class="titular titular--3">Stock <span class="cursiva">bajo</span></h2>
        {
          stockBajo.length === 0 ? (
            <p class="lectura">Nada por debajo de 6 unidades. Los productos sin control de stock no aparecen aquí.</p>
          ) : (
            <ul class="bajo" role="list">
              {stockBajo.map((a) => (
                <li>
                  <Miniatura articulo={a} tam={40} />
                  <span class="bajo__nombre">{a.nombre}<small>{a.formato}</small></span>
                  <strong class:list={['bajo__n', a.stock === 0 && 'bajo__n--cero']}>{a.stock}</strong>
                </li>
              ))}
            </ul>
          )
        }
        <a class="boton boton--pequeno" href="/admin/productos">Editar productos</a>
      </aside>
    </div>
  </section>
</Base>

<style>
  .admin {
    display: grid;
    gap: clamp(28px, 4vw, 48px);
    padding-block: clamp(32px, 5vw, 64px) clamp(64px, 8vw, 112px);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    list-style: none;
    padding: 0;
  }

  .stat {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    min-height: 170px;
    padding: 24px;
    border-radius: var(--radio);
    background: var(--blanco);
  }

  .stat--albero {
    background: var(--albero);
  }

  .stat--persiana {
    background: var(--persiana);
    color: var(--cal);
  }

  .stat__pie {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .stat__num {
    font-size: clamp(2.8rem, 4.5vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
  }

  .stat__num--dinero {
    font-size: clamp(2rem, 3vw, 3rem);
  }

  .admin__rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 360px);
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
  }

  .admin__tabla,
  .admin__vacio {
    margin-top: 16px;
  }

  .admin__lado {
    display: grid;
    gap: 16px;
    justify-items: start;
    padding: 24px;
    border-radius: var(--radio-g);
    background: var(--cal-2);
  }

  .bajo {
    display: grid;
    gap: 8px;
    width: 100%;
    list-style: none;
    padding: 0;
  }

  .bajo li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .bajo__nombre {
    display: flex;
    flex-direction: column;
    flex: 1;
    font-weight: 700;
  }

  .bajo__nombre small {
    font-weight: 400;
    color: var(--texto-2);
  }

  .bajo__n {
    font-size: 1.4rem;
  }

  .bajo__n--cero {
    color: var(--error);
  }

  @media (max-width: 1000px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .admin__rejilla {
      grid-template-columns: 1fr;
    }
  }
</style>
